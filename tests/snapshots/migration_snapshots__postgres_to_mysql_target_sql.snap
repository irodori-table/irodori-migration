---
source: tests/migration_snapshots.rs
assertion_line: 34
expression: plan.target_sql
---
-- Load the exported files with the target engine's bulk loader.
-- Keep the irodori_row_hash column in a staging or manifest table until validation passes.

-- Manifest tables hold source and target MD5 row hashes for fast diff.
CREATE OR REPLACE TEMP TABLE irodori_source_manifest (
  order_id VARCHAR(4000),
  line_id VARCHAR(4000),
  irodori_key_hash VARCHAR(4000),
  irodori_row_hash VARCHAR(4000),
  irodori_partition VARCHAR(4000)
);

CREATE OR REPLACE TEMP TABLE irodori_target_manifest (
  order_id VARCHAR(4000),
  line_id VARCHAR(4000),
  irodori_key_hash VARCHAR(4000),
  irodori_row_hash VARCHAR(4000),
  irodori_partition VARCHAR(4000)
);

-- Stores generated chunk boundaries so validation can resume without re-walking the source table.
CREATE TABLE IF NOT EXISTS irodori_migration_chunks (
  migration_id VARCHAR(4000) NOT NULL,
  table_name VARCHAR(4000) NOT NULL,
  chunk_id VARCHAR(4000) NOT NULL,
  lower_boundary VARCHAR(4000),
  upper_boundary VARCHAR(4000),
  key_count BIGINT,
  created_at TIMESTAMP
);

-- Checkpoint table for resumable chunk validation and backfill workers.
CREATE TABLE IF NOT EXISTS irodori_migration_checkpoints (
  migration_id VARCHAR(4000) NOT NULL,
  table_name VARCHAR(4000) NOT NULL,
  chunk_id VARCHAR(4000) NOT NULL,
  status VARCHAR(4000) NOT NULL,
  row_count BIGINT,
  checksum VARCHAR(4000),
  error_message VARCHAR(4000),
  updated_at TIMESTAMP
);

-- Resume cursor: pick the first chunk that has not reached a completed checkpoint.
SELECT
  c.chunk_id,
  c.lower_boundary,
  c.upper_boundary
FROM irodori_migration_chunks c
LEFT JOIN irodori_migration_checkpoints p
  ON p.migration_id = '${IRODORI_MIGRATION_ID}'
  AND p.table_name = 'warehouse.orders'
  AND p.chunk_id = c.chunk_id
  AND p.status = 'completed'
WHERE c.migration_id = '${IRODORI_MIGRATION_ID}'
  AND c.table_name = 'warehouse.orders'
  AND p.chunk_id IS NULL
ORDER BY c.chunk_id
LIMIT 1;

-- Mark a chunk completed after source/target counts and checksum/hash gates pass.
DELETE FROM irodori_migration_checkpoints
WHERE migration_id = '${IRODORI_MIGRATION_ID}'
  AND table_name = 'warehouse.orders'
  AND chunk_id = '${IRODORI_CHUNK_ID}';
INSERT INTO irodori_migration_checkpoints (migration_id, table_name, chunk_id, status, row_count, checksum, updated_at)
VALUES ('${IRODORI_MIGRATION_ID}', 'warehouse.orders', '${IRODORI_CHUNK_ID}', 'completed', ${IRODORI_ROW_COUNT}, '${IRODORI_CHECKSUM}', CURRENT_TIMESTAMP);

-- Fast MD5 validation fingerprint. Use this before running row-level diff.
WITH row_hashes AS (
  -- Row hash manifest query using MD5 over Irodori canonical row strings.
  SELECT
    order_id,
    line_id,
    amount,
    status,
    sales_dt AS irodori_partition,
    LOWER(MD5(CONCAT(CASE WHEN REGEXP_REPLACE(CAST(order_id AS CHAR), '\s+', ' ') IS NULL THEN '__IRODORI_NULL__' ELSE CONCAT('V', CONCAT(LENGTH(REGEXP_REPLACE(CAST(order_id AS CHAR), '\s+', ' ')), ':', REGEXP_REPLACE(CAST(order_id AS CHAR), '\s+', ' '))) END, '|#|', CASE WHEN REGEXP_REPLACE(CAST(line_id AS CHAR), '\s+', ' ') IS NULL THEN '__IRODORI_NULL__' ELSE CONCAT('V', CONCAT(LENGTH(REGEXP_REPLACE(CAST(line_id AS CHAR), '\s+', ' ')), ':', REGEXP_REPLACE(CAST(line_id AS CHAR), '\s+', ' '))) END))) AS irodori_key_hash,
    LOWER(MD5(CONCAT(CASE WHEN REGEXP_REPLACE(CAST(order_id AS CHAR), '\s+', ' ') IS NULL THEN '__IRODORI_NULL__' ELSE CONCAT('V', CONCAT(LENGTH(REGEXP_REPLACE(CAST(order_id AS CHAR), '\s+', ' ')), ':', REGEXP_REPLACE(CAST(order_id AS CHAR), '\s+', ' '))) END, '|#|', CASE WHEN REGEXP_REPLACE(CAST(line_id AS CHAR), '\s+', ' ') IS NULL THEN '__IRODORI_NULL__' ELSE CONCAT('V', CONCAT(LENGTH(REGEXP_REPLACE(CAST(line_id AS CHAR), '\s+', ' ')), ':', REGEXP_REPLACE(CAST(line_id AS CHAR), '\s+', ' '))) END, '|#|', CASE WHEN REGEXP_REPLACE(CAST(amount AS CHAR), '\s+', ' ') IS NULL THEN '__IRODORI_NULL__' ELSE CONCAT('V', CONCAT(LENGTH(REGEXP_REPLACE(CAST(amount AS CHAR), '\s+', ' ')), ':', REGEXP_REPLACE(CAST(amount AS CHAR), '\s+', ' '))) END, '|#|', CASE WHEN REGEXP_REPLACE(CAST(status AS CHAR), '\s+', ' ') IS NULL THEN '__IRODORI_NULL__' ELSE CONCAT('V', CONCAT(LENGTH(REGEXP_REPLACE(CAST(status AS CHAR), '\s+', ' ')), ':', REGEXP_REPLACE(CAST(status AS CHAR), '\s+', ' '))) END))) AS irodori_row_hash
  FROM warehouse.orders
  WHERE sales_dt >= '2026-01-01'
)
SELECT
  COUNT(*) AS row_count,
  COUNT(DISTINCT CONCAT(CASE WHEN CAST(order_id AS CHAR) IS NULL THEN '__IRODORI_NULL__' ELSE CONCAT('V', CONCAT(LENGTH(CAST(order_id AS CHAR)), ':', CAST(order_id AS CHAR))) END, '', CASE WHEN CAST(line_id AS CHAR) IS NULL THEN '__IRODORI_NULL__' ELSE CONCAT('V', CONCAT(LENGTH(CAST(line_id AS CHAR)), ':', CAST(line_id AS CHAR))) END)) AS key_count,
  MIN(irodori_row_hash) AS min_row_hash,
  MAX(irodori_row_hash) AS max_row_hash
FROM row_hashes;

-- Partition fingerprint. Run row-level diff only for failed partitions.
WITH row_hashes AS (
  -- Row hash manifest query using MD5 over Irodori canonical row strings.
  SELECT
    order_id,
    line_id,
    amount,
    status,
    sales_dt AS irodori_partition,
    LOWER(MD5(CONCAT(CASE WHEN REGEXP_REPLACE(CAST(order_id AS CHAR), '\s+', ' ') IS NULL THEN '__IRODORI_NULL__' ELSE CONCAT('V', CONCAT(LENGTH(REGEXP_REPLACE(CAST(order_id AS CHAR), '\s+', ' ')), ':', REGEXP_REPLACE(CAST(order_id AS CHAR), '\s+', ' '))) END, '|#|', CASE WHEN REGEXP_REPLACE(CAST(line_id AS CHAR), '\s+', ' ') IS NULL THEN '__IRODORI_NULL__' ELSE CONCAT('V', CONCAT(LENGTH(REGEXP_REPLACE(CAST(line_id AS CHAR), '\s+', ' ')), ':', REGEXP_REPLACE(CAST(line_id AS CHAR), '\s+', ' '))) END))) AS irodori_key_hash,
    LOWER(MD5(CONCAT(CASE WHEN REGEXP_REPLACE(CAST(order_id AS CHAR), '\s+', ' ') IS NULL THEN '__IRODORI_NULL__' ELSE CONCAT('V', CONCAT(LENGTH(REGEXP_REPLACE(CAST(order_id AS CHAR), '\s+', ' ')), ':', REGEXP_REPLACE(CAST(order_id AS CHAR), '\s+', ' '))) END, '|#|', CASE WHEN REGEXP_REPLACE(CAST(line_id AS CHAR), '\s+', ' ') IS NULL THEN '__IRODORI_NULL__' ELSE CONCAT('V', CONCAT(LENGTH(REGEXP_REPLACE(CAST(line_id AS CHAR), '\s+', ' ')), ':', REGEXP_REPLACE(CAST(line_id AS CHAR), '\s+', ' '))) END, '|#|', CASE WHEN REGEXP_REPLACE(CAST(amount AS CHAR), '\s+', ' ') IS NULL THEN '__IRODORI_NULL__' ELSE CONCAT('V', CONCAT(LENGTH(REGEXP_REPLACE(CAST(amount AS CHAR), '\s+', ' ')), ':', REGEXP_REPLACE(CAST(amount AS CHAR), '\s+', ' '))) END, '|#|', CASE WHEN REGEXP_REPLACE(CAST(status AS CHAR), '\s+', ' ') IS NULL THEN '__IRODORI_NULL__' ELSE CONCAT('V', CONCAT(LENGTH(REGEXP_REPLACE(CAST(status AS CHAR), '\s+', ' ')), ':', REGEXP_REPLACE(CAST(status AS CHAR), '\s+', ' '))) END))) AS irodori_row_hash
  FROM warehouse.orders
  WHERE sales_dt >= '2026-01-01'
)
SELECT
  irodori_partition AS irodori_partition,
  COUNT(*) AS row_count,
  COUNT(DISTINCT CONCAT(CASE WHEN CAST(order_id AS CHAR) IS NULL THEN '__IRODORI_NULL__' ELSE CONCAT('V', CONCAT(LENGTH(CAST(order_id AS CHAR)), ':', CAST(order_id AS CHAR))) END, '', CASE WHEN CAST(line_id AS CHAR) IS NULL THEN '__IRODORI_NULL__' ELSE CONCAT('V', CONCAT(LENGTH(CAST(line_id AS CHAR)), ':', CAST(line_id AS CHAR))) END)) AS key_count,
  MIN(irodori_row_hash) AS min_row_hash,
  MAX(irodori_row_hash) AS max_row_hash
FROM row_hashes
GROUP BY irodori_partition
ORDER BY irodori_partition;
