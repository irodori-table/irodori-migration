-- Chunk iterator. Feed each chunk_id/lower/upper into checksum and load workers; batch_size=5000000.
WITH ordered_keys AS (
  SELECT
    order_id AS order_id,
    line_id AS line_id
  FROM public.orders
WHERE sales_dt >= '2026-01-01'
  GROUP BY order_id, line_id
),
numbered_keys AS (
  SELECT
    order_id, line_id,
    ROW_NUMBER() OVER (ORDER BY order_id, line_id) AS irodori_row_number
  FROM ordered_keys
),
chunked_keys AS (
  SELECT
    order_id, line_id,
    FLOOR((irodori_row_number - 1) / 5000000) AS irodori_chunk_ordinal
  FROM numbered_keys
)
SELECT
  irodori_chunk_ordinal AS chunk_id,
  MIN(order_id) AS lower_boundary,
  MAX(order_id) AS upper_boundary,
  COUNT(*) AS key_count
FROM chunked_keys
GROUP BY irodori_chunk_ordinal
ORDER BY irodori_chunk_ordinal;

-- Row hash manifest query using MD5 over Irodori canonical row strings.
SELECT
  order_id,
  line_id,
  amount,
  status,
  sales_dt AS irodori_partition,
  LOWER(MD5(CONCAT(CASE WHEN REGEXP_REPLACE(CAST(order_id AS TEXT), '\s+', ' ', 'g') IS NULL THEN '__IRODORI_NULL__' ELSE CONCAT('V', CONCAT(LENGTH(REGEXP_REPLACE(CAST(order_id AS TEXT), '\s+', ' ', 'g')), ':', REGEXP_REPLACE(CAST(order_id AS TEXT), '\s+', ' ', 'g'))) END, '|#|', CASE WHEN REGEXP_REPLACE(CAST(line_id AS TEXT), '\s+', ' ', 'g') IS NULL THEN '__IRODORI_NULL__' ELSE CONCAT('V', CONCAT(LENGTH(REGEXP_REPLACE(CAST(line_id AS TEXT), '\s+', ' ', 'g')), ':', REGEXP_REPLACE(CAST(line_id AS TEXT), '\s+', ' ', 'g'))) END))) AS irodori_key_hash,
  LOWER(MD5(CONCAT(CASE WHEN REGEXP_REPLACE(CAST(order_id AS TEXT), '\s+', ' ', 'g') IS NULL THEN '__IRODORI_NULL__' ELSE CONCAT('V', CONCAT(LENGTH(REGEXP_REPLACE(CAST(order_id AS TEXT), '\s+', ' ', 'g')), ':', REGEXP_REPLACE(CAST(order_id AS TEXT), '\s+', ' ', 'g'))) END, '|#|', CASE WHEN REGEXP_REPLACE(CAST(line_id AS TEXT), '\s+', ' ', 'g') IS NULL THEN '__IRODORI_NULL__' ELSE CONCAT('V', CONCAT(LENGTH(REGEXP_REPLACE(CAST(line_id AS TEXT), '\s+', ' ', 'g')), ':', REGEXP_REPLACE(CAST(line_id AS TEXT), '\s+', ' ', 'g'))) END, '|#|', CASE WHEN REGEXP_REPLACE(CAST(amount AS TEXT), '\s+', ' ', 'g') IS NULL THEN '__IRODORI_NULL__' ELSE CONCAT('V', CONCAT(LENGTH(REGEXP_REPLACE(CAST(amount AS TEXT), '\s+', ' ', 'g')), ':', REGEXP_REPLACE(CAST(amount AS TEXT), '\s+', ' ', 'g'))) END, '|#|', CASE WHEN REGEXP_REPLACE(CAST(status AS TEXT), '\s+', ' ', 'g') IS NULL THEN '__IRODORI_NULL__' ELSE CONCAT('V', CONCAT(LENGTH(REGEXP_REPLACE(CAST(status AS TEXT), '\s+', ' ', 'g')), ':', REGEXP_REPLACE(CAST(status AS TEXT), '\s+', ' ', 'g'))) END))) AS irodori_row_hash
FROM public.orders
WHERE sales_dt >= '2026-01-01';

-- Fast MD5 validation fingerprint. Use this before running row-level diff.
WITH row_hashes AS (
  -- Row hash manifest query using MD5 over Irodori canonical row strings.
  SELECT
    order_id,
    line_id,
    amount,
    status,
    sales_dt AS irodori_partition,
    LOWER(MD5(CONCAT(CASE WHEN REGEXP_REPLACE(CAST(order_id AS TEXT), '\s+', ' ', 'g') IS NULL THEN '__IRODORI_NULL__' ELSE CONCAT('V', CONCAT(LENGTH(REGEXP_REPLACE(CAST(order_id AS TEXT), '\s+', ' ', 'g')), ':', REGEXP_REPLACE(CAST(order_id AS TEXT), '\s+', ' ', 'g'))) END, '|#|', CASE WHEN REGEXP_REPLACE(CAST(line_id AS TEXT), '\s+', ' ', 'g') IS NULL THEN '__IRODORI_NULL__' ELSE CONCAT('V', CONCAT(LENGTH(REGEXP_REPLACE(CAST(line_id AS TEXT), '\s+', ' ', 'g')), ':', REGEXP_REPLACE(CAST(line_id AS TEXT), '\s+', ' ', 'g'))) END))) AS irodori_key_hash,
    LOWER(MD5(CONCAT(CASE WHEN REGEXP_REPLACE(CAST(order_id AS TEXT), '\s+', ' ', 'g') IS NULL THEN '__IRODORI_NULL__' ELSE CONCAT('V', CONCAT(LENGTH(REGEXP_REPLACE(CAST(order_id AS TEXT), '\s+', ' ', 'g')), ':', REGEXP_REPLACE(CAST(order_id AS TEXT), '\s+', ' ', 'g'))) END, '|#|', CASE WHEN REGEXP_REPLACE(CAST(line_id AS TEXT), '\s+', ' ', 'g') IS NULL THEN '__IRODORI_NULL__' ELSE CONCAT('V', CONCAT(LENGTH(REGEXP_REPLACE(CAST(line_id AS TEXT), '\s+', ' ', 'g')), ':', REGEXP_REPLACE(CAST(line_id AS TEXT), '\s+', ' ', 'g'))) END, '|#|', CASE WHEN REGEXP_REPLACE(CAST(amount AS TEXT), '\s+', ' ', 'g') IS NULL THEN '__IRODORI_NULL__' ELSE CONCAT('V', CONCAT(LENGTH(REGEXP_REPLACE(CAST(amount AS TEXT), '\s+', ' ', 'g')), ':', REGEXP_REPLACE(CAST(amount AS TEXT), '\s+', ' ', 'g'))) END, '|#|', CASE WHEN REGEXP_REPLACE(CAST(status AS TEXT), '\s+', ' ', 'g') IS NULL THEN '__IRODORI_NULL__' ELSE CONCAT('V', CONCAT(LENGTH(REGEXP_REPLACE(CAST(status AS TEXT), '\s+', ' ', 'g')), ':', REGEXP_REPLACE(CAST(status AS TEXT), '\s+', ' ', 'g'))) END))) AS irodori_row_hash
  FROM public.orders
  WHERE sales_dt >= '2026-01-01'
)
SELECT
  COUNT(*) AS row_count,
  COUNT(DISTINCT CONCAT(CASE WHEN CAST(order_id AS TEXT) IS NULL THEN '__IRODORI_NULL__' ELSE CONCAT('V', CONCAT(LENGTH(CAST(order_id AS TEXT)), ':', CAST(order_id AS TEXT))) END, '', CASE WHEN CAST(line_id AS TEXT) IS NULL THEN '__IRODORI_NULL__' ELSE CONCAT('V', CONCAT(LENGTH(CAST(line_id AS TEXT)), ':', CAST(line_id AS TEXT))) END)) AS key_count,
  MIN(irodori_row_hash) AS min_row_hash,
  MAX(irodori_row_hash) AS max_row_hash
FROM row_hashes;

-- Partition fingerprint. Run row-level diff only for failed partitions.
WITH row_hashes AS (
  -- Row hash manifest query using MD5 over Irodori canonical row strings.
  SELECT
    order_id,
    line_id,
    amount,
    status,
    sales_dt AS irodori_partition,
    LOWER(MD5(CONCAT(CASE WHEN REGEXP_REPLACE(CAST(order_id AS TEXT), '\s+', ' ', 'g') IS NULL THEN '__IRODORI_NULL__' ELSE CONCAT('V', CONCAT(LENGTH(REGEXP_REPLACE(CAST(order_id AS TEXT), '\s+', ' ', 'g')), ':', REGEXP_REPLACE(CAST(order_id AS TEXT), '\s+', ' ', 'g'))) END, '|#|', CASE WHEN REGEXP_REPLACE(CAST(line_id AS TEXT), '\s+', ' ', 'g') IS NULL THEN '__IRODORI_NULL__' ELSE CONCAT('V', CONCAT(LENGTH(REGEXP_REPLACE(CAST(line_id AS TEXT), '\s+', ' ', 'g')), ':', REGEXP_REPLACE(CAST(line_id AS TEXT), '\s+', ' ', 'g'))) END))) AS irodori_key_hash,
    LOWER(MD5(CONCAT(CASE WHEN REGEXP_REPLACE(CAST(order_id AS TEXT), '\s+', ' ', 'g') IS NULL THEN '__IRODORI_NULL__' ELSE CONCAT('V', CONCAT(LENGTH(REGEXP_REPLACE(CAST(order_id AS TEXT), '\s+', ' ', 'g')), ':', REGEXP_REPLACE(CAST(order_id AS TEXT), '\s+', ' ', 'g'))) END, '|#|', CASE WHEN REGEXP_REPLACE(CAST(line_id AS TEXT), '\s+', ' ', 'g') IS NULL THEN '__IRODORI_NULL__' ELSE CONCAT('V', CONCAT(LENGTH(REGEXP_REPLACE(CAST(line_id AS TEXT), '\s+', ' ', 'g')), ':', REGEXP_REPLACE(CAST(line_id AS TEXT), '\s+', ' ', 'g'))) END, '|#|', CASE WHEN REGEXP_REPLACE(CAST(amount AS TEXT), '\s+', ' ', 'g') IS NULL THEN '__IRODORI_NULL__' ELSE CONCAT('V', CONCAT(LENGTH(REGEXP_REPLACE(CAST(amount AS TEXT), '\s+', ' ', 'g')), ':', REGEXP_REPLACE(CAST(amount AS TEXT), '\s+', ' ', 'g'))) END, '|#|', CASE WHEN REGEXP_REPLACE(CAST(status AS TEXT), '\s+', ' ', 'g') IS NULL THEN '__IRODORI_NULL__' ELSE CONCAT('V', CONCAT(LENGTH(REGEXP_REPLACE(CAST(status AS TEXT), '\s+', ' ', 'g')), ':', REGEXP_REPLACE(CAST(status AS TEXT), '\s+', ' ', 'g'))) END))) AS irodori_row_hash
  FROM public.orders
  WHERE sales_dt >= '2026-01-01'
)
SELECT
  irodori_partition AS irodori_partition,
  COUNT(*) AS row_count,
  COUNT(DISTINCT CONCAT(CASE WHEN CAST(order_id AS TEXT) IS NULL THEN '__IRODORI_NULL__' ELSE CONCAT('V', CONCAT(LENGTH(CAST(order_id AS TEXT)), ':', CAST(order_id AS TEXT))) END, '', CASE WHEN CAST(line_id AS TEXT) IS NULL THEN '__IRODORI_NULL__' ELSE CONCAT('V', CONCAT(LENGTH(CAST(line_id AS TEXT)), ':', CAST(line_id AS TEXT))) END)) AS key_count,
  MIN(irodori_row_hash) AS min_row_hash,
  MAX(irodori_row_hash) AS max_row_hash
FROM row_hashes
GROUP BY irodori_partition
ORDER BY irodori_partition;
